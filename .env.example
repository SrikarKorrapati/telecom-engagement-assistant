# Copy to .env. Keys stay in the Streamlit server process and are never displayed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
DATABASE_URL=postgresql+psycopg2://telecom@127.0.0.1:55432/telecom_demo
# Hosted deployments require these; leave unset for the local loopback demo.
# REQUIRE_DEMO_LOGIN=true
# DEMO_ACCESS_PASSWORD=<random password of at least 16 characters>
# POLICY_STORAGE=database
